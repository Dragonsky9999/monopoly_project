Set-Location C:\Users\drago\projects\monopoly_project

# 1. 長編テスト用ファイル (monopoly_advanced.state) の生成
@'
[META]
turnNumber=5
currentPhase=2
activePlayerIndex=0
enableTax=1

[PLAYERS]
playerCount=3
p:0,Riku,850,15,0
cards:0,1,22
